# ---------------------------------------------------------------------------
# avila-mail — servidor de e-mail proprio (mail.avilaops.com)
# Copie para .env.production e preencha. NUNCA versione o arquivo preenchido.
# ---------------------------------------------------------------------------

# Banco dedicado do e-mail, na instancia PostgreSQL que ja roda no VPS
MAIL_DATABASE_URL="postgresql://avila_mail:TROCAR@127.0.0.1:5432/avila_mail?schema=public"

# Identidade do servidor. Precisa bater com o rDNS do IP e com o A record.
MAIL_HOSTNAME="mail.avilaops.com"

# Diretorio das mensagens brutas (.eml.gz). Fonte da verdade do conteudo.
MAIL_STORAGE_DIR="/var/lib/avila-mail/blobs"

# --- Portas SMTP ---
# 25 = entrada e saida direta. 587/465 = submission autenticada.
MAIL_INBOUND_PORT="25"
MAIL_SUBMISSION_PORT="587"
MAIL_SUBMISSION_TLS_PORT="465"

# Certificado TLS (o mesmo do Caddy/certbot para mail.avilaops.com)
MAIL_TLS_CERT_PATH="/etc/letsencrypt/live/mail.avilaops.com/fullchain.pem"
MAIL_TLS_KEY_PATH="/etc/letsencrypt/live/mail.avilaops.com/privkey.pem"

# --- API de provisionamento (consumida pelo portal do cliente e pelo n8n) ---
MAIL_API_PORT="3040"
MAIL_API_BIND="127.0.0.1"
# Token bearer compartilhado com o portal. Gere com: openssl rand -hex 32
MAIL_API_TOKEN=""

# --- Saida de e-mail ---
# "direct" — entrega MX-a-MX pelo nosso proprio IP, custo zero, sem terceiros.
# A Hetzner liberou a porta 25 de saida em 14/08/2026; este e o caminho normal.
#
# As pontes seguem disponiveis como contingencia (bloqueio de reputacao do IP,
# provedor recusando nossa faixa):
#   smtp = relay em 587/465 com credencial propria
#   n8n  = ponte pelo workflow de relay do n8n
#
# Trocar aqui e reiniciar o MTA e tudo que e preciso. A fila e a mesma.
MAIL_RELAY_DRIVER="direct"

MAIL_RELAY_SMTP_HOST=""
MAIL_RELAY_SMTP_PORT="587"
MAIL_RELAY_SMTP_USER=""
MAIL_RELAY_SMTP_PASS=""

MAIL_RELAY_N8N_URL=""
MAIL_RELAY_N8N_TOKEN=""

# --- Aquecimento de IP (so vale para o driver "direct") ---
# O IP nunca enviou e-mail: volume subito de IP desconhecido e a assinatura
# classica de spammer para Gmail e Outlook. A rampa segura o excedente na fila
# ate o dia seguinte (UTC) — nada e recusado nem vira bounce.
#
# Data do dia 1 da rampa (YYYY-MM-DD). Vazio = sem aquecimento.
MAIL_WARMUP_INICIO=""
# Teto DIARIO de mensagens externas, um valor por semana da rampa.
# Terminada a lista, o teto some. Mensagem entre caixas nossas nao conta.
MAIL_WARMUP_CAPS="30,60,120,250,500,1000"

# --- Criptografia das chaves DKIM privadas em repouso ---
# 32 bytes em hex. Gere com: openssl rand -hex 32
MAIL_DKIM_ENCRYPTION_KEY=""

# --- Sessao do dono da caixa (webmail) ---
# Assina o access token. Trocar este valor desconecta todo mundo.
# Gere com: openssl rand -hex 48
MAIL_JWT_SECRET=""
MAIL_ACCESS_TOKEN_MINUTES="15"
MAIL_REFRESH_TOKEN_DAYS="30"
# Tentativas de login erradas por janela de 15 min antes de bloquear.
MAIL_LOGIN_MAX_FAILURES="8"

# --- Cobranca (Mercado Pago) ---
# Assinatura recorrente no cartao. O cartao e cadastrado na pagina do proprio
# Mercado Pago: nenhum dado de cartao passa por aqui.
MP_ACCESS_TOKEN=""
# Segredo da integracao, em Suas integracoes > Webhooks. Sem ele o endpoint
# de notificacao recusa tudo — e ele que impede alguem de forjar "pagamento
# aprovado" para reativar uma caixa suspensa.
MP_WEBHOOK_SECRET=""
# Para onde o cliente volta depois de cadastrar o cartao. OBRIGATORIO quando
# a cobranca esta ligada: precisa ser uma pagina LOGADA do portal que exista de
# verdade, senao o cliente paga e cai numa tela morta. Sem valor padrao de
# proposito — dominio embutido sobrevive a mudanca de marca sem ninguem notar.
MP_BACK_URL=""

# Preco por caixa, em centavos. R$ 10,00 = 1000.
MAIL_PRECO_CAIXA_CENTAVOS="1000"
# Dias de tolerancia depois da primeira recusa antes de bloquear o acesso.
MAIL_DIAS_TOLERANCIA="5"

# --- Limites ---
MAIL_MAX_MESSAGE_BYTES="26214400"
MAIL_DEFAULT_QUOTA_GB="5"
MAIL_DEFAULT_SEND_LIMIT_PER_HOUR="200"
MAIL_MAX_DELIVERY_ATTEMPTS="12"

# --- Area de desenvolvedor (chaves de API) ---
# Caixas (ou donos no SSO) que podem criar chave de PROVISIONAMENTO pela tela.
# Chave de escopo "caixa" qualquer dono cria. Vazio = ninguem provisiona por chave.
#
# E tambem para onde vai o aviso da conferencia diaria de DNS: dominio de
# cliente que perdeu MX, SPF, DKIM ou DMARC. Vazio = a conferencia continua
# rodando e registrando, mas ninguem e avisado.
MAIL_ADMIN_ADDRESSES="nicolas@avilaops.com"

# --- Aviso de mensagem nova com a aba fechada (Web Push) ---
# Gere uma vez com:  node -e "console.log(require('web-push').generateVAPIDKeys())"
# Trocar as chaves invalida as assinaturas existentes: todo mundo precisa
# autorizar de novo. Vazio = recurso desligado.
MAIL_VAPID_PUBLIC_KEY=""
MAIL_VAPID_PRIVATE_KEY=""
MAIL_VAPID_SUBJECT="mailto:suporte@avilaops.com"
