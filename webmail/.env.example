# Interface do webmail — mail.avilaops.com

# API do servidor de e-mail. Loopback: o webmail roda no mesmo host.
MAIL_API_URL="http://127.0.0.1:3040/v1"

# Em desenvolvimento (http://localhost) o cookie Secure nao e aceito pelo
# navegador. NUNCA colocar "false" em producao.
COOKIE_SECURE="true"

# Portal que cuida de cadastro, dominio e cobranca (destino do "Criar conta").
PORTAL_URL="https://cliente.avilaops.com"

# Agenda: false = escondida; internal = apenas dominios abaixo; all = todas as caixas.
AGENDA_ENABLED="false"
AGENDA_INTERNAL_DOMAINS="avilaops.com"
